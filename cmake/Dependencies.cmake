# Offline dependency discovery. Explicit paths and CMAKE_PREFIX_PATH override
# the conventional source-tree dependencies/ layout; never download at configure time.
set(CCRIDE_DEPS_DIR "${CMAKE_SOURCE_DIR}/dependencies" CACHE PATH "Root of local dependencies")
set(IMGUI_DIR "" CACHE PATH "Dear ImGui docking source directory")
set(GLFW_DIR "" CACHE PATH "GLFW installation or prebuilt directory")
set(NLOHMANN_DIR "" CACHE PATH "Directory containing nlohmann/json.hpp")
foreach(derived CCRIDE_IMGUI_ROOT CCRIDE_JSON_INCLUDE CCRIDE_GLFW_INCLUDE CCRIDE_GLFW_LIBRARY)
    unset(${derived} CACHE)
endforeach()

find_path(CCRIDE_IMGUI_ROOT imgui.cpp HINTS "${IMGUI_DIR}" "${CCRIDE_DEPS_DIR}/imgui")
if(NOT CCRIDE_IMGUI_ROOT)
    message(FATAL_ERROR "Dear ImGui docking sources not found. Set IMGUI_DIR or place sources in CCRIDE_DEPS_DIR/imgui. See docs/building.md.")
endif()
set(IMGUI_DIR "${CCRIDE_IMGUI_ROOT}")
foreach(file imgui.cpp imgui.h imgui_draw.cpp imgui_tables.cpp imgui_widgets.cpp backends/imgui_impl_glfw.cpp backends/imgui_impl_opengl3.cpp)
    if(NOT EXISTS "${IMGUI_DIR}/${file}")
        message(FATAL_ERROR "Incomplete ImGui sources: missing ${file} in ${IMGUI_DIR}")
    endif()
endforeach()
file(STRINGS "${IMGUI_DIR}/imgui.h" CCRIDE_DOCKING_MARKER REGEX "^#define IMGUI_HAS_DOCK")
if(NOT CCRIDE_DOCKING_MARKER)
    message(FATAL_ERROR "ccrIDE requires Dear ImGui docking, not the master branch.")
endif()

find_path(CCRIDE_JSON_INCLUDE nlohmann/json.hpp HINTS "${NLOHMANN_DIR}" "${CCRIDE_DEPS_DIR}/nlohmann" PATH_SUFFIXES include "")
if(NOT CCRIDE_JSON_INCLUDE)
    message(FATAL_ERROR "nlohmann/json.hpp not found. Set NLOHMANN_DIR or CCRIDE_DEPS_DIR. See docs/building.md.")
endif()
set(NLOHMANN_DIR "${CCRIDE_JSON_INCLUDE}")

if(NOT GLFW_DIR)
    find_package(glfw3 3.4 CONFIG QUIET)
endif()
if(TARGET glfw)
    set(CCRIDE_GLFW_TARGET glfw)
elseif(TARGET glfw3::glfw)
    set(CCRIDE_GLFW_TARGET glfw3::glfw)
else()
    find_path(CCRIDE_GLFW_INCLUDE GLFW/glfw3.h HINTS "${GLFW_DIR}" "${CCRIDE_DEPS_DIR}/glfw" PATH_SUFFIXES include)
    find_library(CCRIDE_GLFW_LIBRARY NAMES glfw3 HINTS "${GLFW_DIR}" "${CCRIDE_DEPS_DIR}/glfw" PATH_SUFFIXES lib lib64 "")
    if(NOT CCRIDE_GLFW_INCLUDE OR NOT CCRIDE_GLFW_LIBRARY)
        message(FATAL_ERROR "GLFW headers/library not found. Set GLFW_DIR, install a glfw3 CMake package, or use CCRIDE_DEPS_DIR/glfw. See docs/building.md.")
    endif()
    add_library(ccride_glfw UNKNOWN IMPORTED)
    set_target_properties(ccride_glfw PROPERTIES IMPORTED_LOCATION "${CCRIDE_GLFW_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${CCRIDE_GLFW_INCLUDE}")
    set(CCRIDE_GLFW_TARGET ccride_glfw)
endif()

set(ZLIB_USE_STATIC_LIBS ON)
# Prefer headers and libraries shipped with the selected compiler, rather than
# another MinGW runtime that happens to be installed beside the CMake executable.
if(NOT ZLIB_ROOT)
    get_filename_component(ccride_compiler_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
    get_filename_component(ccride_compiler_root "${ccride_compiler_bin}" DIRECTORY)
    execute_process(COMMAND "${CMAKE_CXX_COMPILER}" -dumpmachine OUTPUT_VARIABLE ccride_compiler_triple OUTPUT_STRIP_TRAILING_WHITESPACE)
    foreach(prefix "${ccride_compiler_root}/${ccride_compiler_triple}" "${ccride_compiler_root}")
        if(EXISTS "${prefix}/include/zlib.h")
            set(ZLIB_ROOT "${prefix}")
            break()
        endif()
    endforeach()
endif()
find_package(ZLIB REQUIRED)
message(STATUS "ccrIDE ImGui: ${IMGUI_DIR}")
message(STATUS "ccrIDE JSON: ${NLOHMANN_DIR}")
message(STATUS "ccrIDE GLFW target: ${CCRIDE_GLFW_TARGET}")
